#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# First-boot defaults for DeepSeek Harness
# Runs once on first install; removed by postinst

# 确保 UCI 段存在(虽然 /etc/config 默认已写,保险)
if ! uci -q get deepseek_harness.main >/dev/null 2>&1; then
	uci set deepseek_harness.main=deepseek_harness
	uci set deepseek_harness.main.enabled='0'
	uci set deepseek_harness.main.install_path='/opt/deepseek-harness'
	uci set deepseek_harness.main.listen_port='8123'
	uci set deepseek_harness.main.listen_host='0.0.0.0'
	uci set deepseek_harness.main.bundle_version='0.1.0-rc.7'
	uci set deepseek_harness.main.arch='auto'
	uci set deepseek_harness.main.api_base='https://api.deepseek.com'
	uci set deepseek_harness.main.api_key=''
	uci set deepseek_harness.main.model='deepseek-chat'
	uci set deepseek_harness.main.temperature='0.7'
	uci set deepseek_harness.main.max_tokens='4096'
	uci set deepseek_harness.main.auto_start='1'
	uci set deepseek_harness.main.cors_origins='*'
	uci set deepseek_harness.main.log_level='info'
	uci set deepseek_harness.main.relay_enabled='0'
	uci commit deepseek_harness
fi

# 确保 init.d 启用
/etc/init.d/deepseek_harness enable >/dev/null 2>&1

# 清理 luci 缓存
rm -f /tmp/luci-indexcache 2>/dev/null

exit 0
